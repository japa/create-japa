{
  "name": "create-japa",
  "description": "Setup japa inside an existing Node.js project",
  "version": "2.1.4",
  "engines": {
    "node": ">=20.9.0"
  },
  "main": "build/index.js",
  "type": "module",
  "files": [
    "build/bin",
    "build/templates",
    "build/src",
    "build/index.d.ts",
    "build/index.js"
  ],
  "bin": {
    "create-japa": "build/bin/run.js"
  },
  "exports": {
    ".": "./build/index.js"
  },
  "scripts": {
    "pretest": "npm run lint && npm run typecheck",
    "test": "c8 npm run quick:test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "clean": "del-cli build",
    "compile": "npm run lint && npm run clean && tsc && copyfiles templates/* build",
    "build": "npm run compile",
    "version": "npm run build",
    "prepublishOnly": "npm run build",
    "release": "release-it",
    "quick:test": "node --import=ts-node-maintained/register/esm --enable-source-maps bin/test.ts"
  },
  "devDependencies": {
    "@adonisjs/eslint-config": "^2.1.0",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^1.4.1",
    "@japa/assert": "^4.1.0",
    "@japa/file-system": "^2.3.2",
    "@japa/runner": "^4.3.0",
    "@release-it/conventional-changelog": "^10.0.1",
    "@swc/core": "^1.13.1",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^24.0.15",
    "@types/which-pm-runs": "^1.0.2",
    "c8": "^10.1.3",
    "copyfiles": "^2.4.1",
    "del-cli": "^6.0.0",
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "release-it": "^19.0.4",
    "ts-node-maintained": "^10.9.5",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@adonisjs/ace": "^13.3.0",
    "@antfu/install-pkg": "^1.1.0",
    "edge.js": "^6.3.0",
    "gradient-string": "^3.0.0",
    "which-pm-runs": "^1.1.0"
  },
  "homepage": "https://github.com/japa/create-japa#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/japa/create-japa.git"
  },
  "bugs": {
    "url": "https://github.com/japa/create-japa/issues"
  },
  "keywords": [
    "japa",
    "init"
  ],
  "author": "Harminder Virk <virk@adonisjs.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "push": true,
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
